---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

// 允许这些字段为可选，防止未传时报错
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  author,
} = Astro.props as Partial<Props> & { title: string };
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image { width: 100%; }
      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
        max-width: 1020px;
        width: 100%;
        height: auto;
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 { margin: 0 0 0.5em 0; }
      .meta {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
        font-size: 0.95em;
      }
      .byline { font-weight: 600; }
      .sep { opacity: .6; padding: 0 .4em; }
      .last-updated-on { font-style: italic; margin-top: .25em; }
      hr { border: none; border-top: 1px solid rgb(var(--gray-light)); }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        {heroImage && (
          <div class="hero-image">
            <img src={heroImage} alt="" loading="eager" decoding="async" />
          </div>
        )}

        <div class="prose">
          <header class="title">
            <div class="meta">
              {pubDate && <FormattedDate date={pubDate} />}

              {author && (
                <>
                  {pubDate && <span class="sep">·</span>}
                  <span class="byline">{author}</span>
                </>
              )}

              {updatedDate && (
                <div class="last-updated-on">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )}
            </div>

            <h1>{title}</h1>
            <hr />
          </header>

          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
