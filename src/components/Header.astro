import { SITE_TITLE_CN, SITE_TITLE_EN, SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <h1 class="site-title">
      <a href="/">
        <span class="title-cn">早期中國法律文獻研讀坊</span>
        <span class="title-en">
  Early Chinese Legal Documents Workshop
</span>
      </a>
    </h1>

<div class="nav-center">
  <a class="nav-link" href="/">Home</a>
  <a class="nav-link" href="/post">Post</a>
  <a class="nav-link" href="/about">About</a>
</div>


		<div class="social-links">
			<!-- WeChat with QR popover -->
<div class="social-item wechat">
  <button class="icon-button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="wechat-popover"
    title="WeChat"
  >
    <img src="/wechat.svg" alt="WeChat" width="32" height="32" />
  </button>

  <div id="wechat-popover" role="dialog" aria-label="WeChat QR code" class="qr-popover" hidden>
    <figure>
      <img src="/qrcode.jpg" alt="WeChat QR code" />
