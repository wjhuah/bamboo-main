				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<script>
  // Minimal toggle for touch/click devices
  const wechatItem = document.querySelector('.social-item.wechat');
  const btn = wechatItem?.querySelector('.icon-button');
  const pop = wechatItem?.querySelector('.qr-popover');

  if (btn && pop) {
    const close = () => {
      pop.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    };
    const open = () => {
      pop.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (pop.hidden) open(); else close();
    });

    pop.addEventListener('click', (e) => e.stopPropagation());

    document.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>

<style>
  :root {
    --header-bg: #b32b2d;     
    --header-text: #ffffff; 
    --header-accent: #ffffff; 
    --nav-gap: 4.5rem;     
    --header-min-h: 84px;   
  }

  header {
    background: var(--header-bg);
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    position: relative;
  }

  nav {
    min-height: var(--header-min-h);
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .site-title { margin: 0; line-height: 1.1; z-index: 2; }
  .site-title a { color: var(--header-text); text-decoration: none; }
  .title-cn {
    display: block;
    font-family: "WenYueMingChao", serif;
    font-weight: 400; 
    font-size: 1.4rem;
  }
  .title-en {
    display: block;
    font-family: "SourceSerif4", serif;
    font-weight: 700;
    font-size: 0.74rem;
    margin-top: 0.18rem;
    letter-spacing: 0.2px;
  }


  .nav-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--nav-gap);
  }

.nav-link {
  color: var(--header-text);
  text-decoration: none;
  padding: 1.1em 0.2em;
  border-bottom: 2px solid transparent;
  font-weight: 500;
  transition: border-color .25s ease, font-weight .25s ease;
}

.nav-link:hover {
  border-bottom-color: var(--header-accent);
  font-weight: 700;
}

.nav-link.active,
.nav-link[aria-current="page"] {
  border-bottom-color: transparent !important;
}


  .social-links { display: flex; gap: 1rem; z-index: 2; }
  .social-links a { color: var(--header-text); }
  .social-links svg { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .nav-link{ transition: none; }
  }

  @media (max-width: 720px) {
    nav { min-height: auto; flex-direction: column; gap: .25rem; padding: .4rem 1rem; }
    .nav-center { position: static; transform: none; gap: 2rem; order: 2; }
    .social-links { order: 3; }
    .title-cn { font-size: 1.25rem; }
    .title-en { font-size: 0.8rem; }
  }
/* WeChat popover */
.social-item { position: relative; }

.icon-button {
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
  display: flex;
  align-items: center;
  line-height: 0;
  color: inherit;
}

.qr-popover[hidden] { display: none; }

.qr-popover {
  position: absolute;
  right: 0;
  top: 120%;
  background: #fff;
  color: #111;
  border-radius: 10px;
  padding: 12px;
  box-shadow: var(--box-shadow, 0 8px 24px rgba(0,0,0,.18));
  width: 220px;
  z-index: 50;
}

.qr-popover img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 8px;
}

.qr-popover figcaption {
  font-size: .8rem;
  margin-top: .4rem;
  text-align: center;
  color: #444;
}

@media (hover:hover) {
  .social-item.wechat:hover .qr-popover {
    display: block;
  }
}

@media (max-width: 720px) {
  .qr-popover {
    right: 50%;
    transform: translateX(50%);
  }
}

</style>
